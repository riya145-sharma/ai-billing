# ---------------------------------------------------------------
# Copy to .env in the project folder (next to bootstrap.php, never in
# public_html) — `php bin/install.php` does this for you. Never commit .env.
# ---------------------------------------------------------------

APP_NAME="AI Content Generator"
# production | local
APP_ENV=production
APP_DEBUG=false
APP_URL=https://ai-billing.example.com
APP_TIMEZONE=Asia/Kolkata

SESSION_NAME=aibill_sid
SESSION_IDLE_MINUTES=60
SESSION_ABSOLUTE_HOURS=12
# Keep true in production (site must be on HTTPS). Set false only for local http://localhost testing.
SESSION_SECURE_COOKIE=true

# Azure OpenAI key (Azure portal → snd-ai-2-resource → Keys and Endpoint).
# Each deployment in storage/data/azure_configurations.json names the variable
# it uses (default AZURE_OPENAI_API_KEY). If an image model lives on another
# resource, add e.g. AZURE_OPENAI_IMAGE_API_KEY= and point that deployment at it.
AZURE_OPENAI_API_KEY=
