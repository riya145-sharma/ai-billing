{
    "name": "staranddaisy/ai-billing",
    "description": "Azure OpenAI usage tracking, billing and image-quota control — file-based (JSON) storage, no database",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-json": "*",
        "ext-curl": "*",
        "ext-mbstring": "*",
        "ext-fileinfo": "*"
    },
    "suggest": {
        "ext-bcmath": "Exact decimal money maths (falls back to rounded floats)",
        "ext-gd": "Image thumbnails (later phases)",
        "ext-zip": "Zipped data backups (falls back to folder copies)"
    },
    "autoload": {
        "psr-4": { "App\\": "app/" }
    },
    "scripts": {
        "app:install": "@php bin/install.php",
        "app:check": "@php bin/check-env.php",
        "app:test": "@php tests/run.php",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@php -S localhost:8000 -t public public/index.php"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "platform": { "php": "8.2.0" }
    }
}
